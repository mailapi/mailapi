root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

[*.md]
# Trailing whitespace is not significant here: prose wraps with hard newlines
# rather than Markdown's two-space line break.
max_line_length = 80

[*.{yaml,yml}]
indent_size = 2

[*.astro]
indent_style = tab

[LICENSE]
trim_trailing_whitespace = false
insert_final_newline = false
